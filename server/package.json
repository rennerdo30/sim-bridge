{
  "name": "sim-bridge-relay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test",
    "test:wasm": "RELAY_TEST_SQL_ENGINE=wasm node --test",
    "test:worker": "RELAY_TEST_TARGET=worker node --test --test-concurrency=2",
    "dev:worker": "wrangler dev --env-file test-support/empty.env",
    "deploy:worker": "wrangler deploy",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.4.4",
    "sql.js": "^1.15.2"
  },
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.137.0"
  },
  "cloudflare": {
    "bindings": {
      "SIM_BRIDGE_ACCESS_KEY": {
        "description": "Owner key: a new random secret of at least 32 characters (for example from `openssl rand -base64 36`). Your Android phone needs it once to create the bridge. Keep it private."
      }
    }
  }
}

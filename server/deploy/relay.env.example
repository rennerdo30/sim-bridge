# Copy to relay.env (gitignored) and keep it private.
# Generate a fresh key with: openssl rand -base64 36
SIM_BRIDGE_ACCESS_KEY=
# The public hostname routed to this relay by the tunnel (no scheme, no port).
SIM_BRIDGE_ALLOWED_HOSTS=relay.example.com
SIM_BRIDGE_RELAY_NAME=Sim Bridge relay
# Optional iPhone push; all three key values together:
# SIM_BRIDGE_APNS_KEY_PATH=/run/secrets/apns.p8
# SIM_BRIDGE_APNS_KEY_ID=
# SIM_BRIDGE_APNS_TEAM_ID=
# SIM_BRIDGE_APNS_TOPIC=

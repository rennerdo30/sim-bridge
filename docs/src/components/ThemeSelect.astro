<sim-bridge-theme-toggle>
  <button type="button" aria-label="Toggle light and dark theme" title="Toggle light and dark theme">
    <svg class="sun-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
    </svg>
    <svg class="moon-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
      <path d="M20 15.5A9 9 0 0 1 8.5 4a9 9 0 1 0 11.5 11.5Z" />
    </svg>
  </button>
</sim-bridge-theme-toggle>

<script>
  class SimBridgeThemeToggle extends HTMLElement {
    toggle = () => {
      const theme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = theme;
      localStorage.setItem('starlight-theme', theme);
    };

    connectedCallback() { this.addEventListener('click', this.toggle); }
    disconnectedCallback() { this.removeEventListener('click', this.toggle); }
  }

  if (!customElements.get('sim-bridge-theme-toggle')) {
    customElements.define('sim-bridge-theme-toggle', SimBridgeThemeToggle);
  }
</script>

<style>
  button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--sl-color-accent-high);
    background: transparent;
    cursor: pointer;
  }
  button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  svg { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; }
  .moon-icon { display: none; }
  :global(.mobile-preferences) sim-bridge-theme-toggle { display: none; }
  :global([data-theme='light']) .sun-icon { display: none; }
  :global([data-theme='light']) .moon-icon { display: block; }
</style>
